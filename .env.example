# SQLite local. La ruta es relativa a la raíz del proyecto.
DATABASE_URL="file:./dev.db"

# Obligatoria al ejecutar `pnpm db:seed`.
# No reutilizar este valor en producción.
SEED_ADMIN_EMAIL="admin@erpiso.local"
SEED_ADMIN_PASSWORD="change-this-before-seeding"
SEED_ADMIN_NAME="Administrador"

# Web Push: generar fuera del repositorio con `pnpm exec web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Producción debe usar una ruta persistente separada, por ejemplo file:/data/erpiso.db.
