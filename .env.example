# PostgreSQL usado por Docker Compose.
POSTGRES_DB="erpiso"
POSTGRES_USER="erpiso"
POSTGRES_PASSWORD="cambiar-esta-clave"
DATABASE_URL="postgresql://erpiso:cambiar-esta-clave@postgres:5432/erpiso?schema=public"

# Puerto HTTP publicado por la aplicación.
APP_PORT="5356"

# Usuario administrador creado o actualizado por el seed.
SEED_ADMIN_EMAIL="admin@erpiso.local"
SEED_ADMIN_PASSWORD="cambiar-esta-clave"
SEED_ADMIN_NAME="Administrador"

# Web Push: generar fuera del repositorio con `pnpm exec web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@erpiso.local"
